    gm:crossref [ gm:categories "Glycomics"^^xsd:string ;
            gm:database "GlyTouCan"^^xsd:string ;
            gm:id "G00055MO"^^xsd:string ;
            gm:url <https://glytoucan.org/Structures/Glycans/G00055MO> ],
        [ gm:categories "Ontology and Dictionary"^^xsd:string ;
            gm:database "Glycan Structure Dictionary"^^xsd:string ;
            gm:id "GSD000129"^^xsd:string ;
            gm:url <https://wiki.glygen.org/Glycan_structure_dictionary#GSD000129> ] ;
    gm:dictionary [ gm:definition "N-acetyllactosamine is a beta-D-galactopyranosyl-(1→4)-N-acetyl-D-glucosamine having beta-configuration at the reducing end anomeric centre. It is also known as galb1-4glcnacb or lacnac, belongs to the class of organic compounds known as acylaminosugars. These are organic compounds containing a sugar linked to a chain through N-acyl group. N-Acetyllactosamine is an extremely weak basic (essentially neutral) compound (based on its pKa). N-Acetyllactosamine exists in all living organisms, ranging from bacteria to humans.[CHEBI:16153,HMDB0001542]"^^xsd:string ;
            gm:disease_associations ""^^xsd:string ;
            gm:essentials_of_glycobiology ""^^xsd:string ;
            gm:evidence [ gm:database "Glycan Structure Dictionary"^^xsd:string ;
                    gm:id "GSD000129"^^xsd:string ;
                    gm:url <https://wiki.glygen.org/Glycan_structure_dictionary#GSD000129> ] ;
            gm:function ""^^xsd:string ;
            gm:publication "31165848|31126011|28796164|6236210|9751793|29740087|9151975|10567443|21472942|26477523|6548353|28167527|20056550|7737204|22052010|10223649|11323440|10420596|7766648|25257940|17977857|15556936|26541999|23650594|9692202|29429899|21062783|25034434|8985145|28503789|8720464/"^^xsd:string ;
            gm:synonymns "LacNAc"^^xsd:string,
                "Type 2 LN"^^xsd:string ;
            gm:term "N-acetyllactosamine (Type 2)"^^xsd:string ;
            gm:term_in_sentence "Utilising a fast and sensitive screening method based on imidazolium-tagged probes, we report unprecedented reversible activity of bacterial beta1,4-galactosyltransferases to catalyse the transgalactosylation from lactose to N-acetylglucosamine to form N-acetyllactosamine in the presence of UDP.[PMID:31165848]"^^xsd:string ;
            gm:term_xref "GTC:G00055MO|CID:439271|CHEBI:16153|MeSH:C000458|GlycoMotif:GGM.000001"^^xsd:string ;
            gm:wikipedia ""^^xsd:string ] ;
    gm:fully_determined "yes"^^xsd:string ;
    gm:glycam "DGalpb1-4DGlcpNAcb1-OH"^^xsd:string ;
